# Local toolchains, Gradle build products and transient caches
.gradle/
.kotlin/
.tools/
**/build/
**/.gradle/
**/.idea/
**/.cxx/
**/captures/
**/outputs/
__pycache__/
*.py[cod]
*.class
local.properties
*.iml

# No binary SDKs or private app artifacts. Only the public Gradle wrapper jar
# is allowed, since it is required to run the exact Gradle distribution.
*.aar
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.apk
*.aab
*.apks
*.zip
*.7z
*.tar
*.gz
*.so
*.dex
*.bin
*.dat
*.db
*.sqlite
*.sqlite3
*.jsonl
*.csv
*.wav
*.pcm
*.mp3
*.m4a
*.mp4
*.webm

# Never store private signing files, endpoints/credentials or environmental config
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
.env
.env.*
*.secret
*.secrets
*.token
*.credentials
**/secrets/
**/credentials/
**/private/
**/recordings/
**/measurements/

# Generated logs, screenshots, APK release output and local verification reports
*.log
*.log.*
*.err
*.tmp
*.bak
*.orig
*.swp
*.png
*.jpg
*.jpeg
*.webp
*.gif
!app/src/**/res/**/*.png
!app/src/**/res/**/*.jpg
!app/src/**/res/**/*.webp
releases/
S4_APK_VERIFICATION.json
build_v2_offline.log
watch-*.png

# Generated, verified archives live outside this repo
archive/
*.bundle
