# Stable source line endings across Windows/Linux for repeatable source snapshots
* text=auto
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.kts text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
gradle/wrapper/gradle-wrapper.jar binary
